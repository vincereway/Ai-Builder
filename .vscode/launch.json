{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ai-Builder",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONIOENCODING": "utf-8"
            },
            "args": [],
            "stopOnEntry": false,
            "redirectOutput": true
        },
        {
            "name": "Python: 현재 파일",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONIOENCODING": "utf-8"
            }
        }
    ]
}