    <height>750</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Ai-Builder</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout_main">
    <!-- 상단 바 -->
    <item>
     <layout class="QHBoxLayout">
      <item>
       <widget class="QPushButton" name="btn_open_settings">
        <property name="text"><string>⚙ 설정</string></property>
       </widget>
      </item>
      <item>
       <spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer>
      </item>
      <item>
       <widget class="QLabel" name="lbl_connection_status_icon">
        <property name="text"><string>⚪</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lbl_connection_status_text">
        <property name="text"><string>미설정</string></property>
       </widget>
      </item>
     </layout>
    </item>
    <!-- 진료 목록 영역 -->
    <item>
     <widget class="QGroupBox" name="group_encounters">
      <property name="title"><string>진료 목록</string></property>
      <layout class="QHBoxLayout">
       <!-- 좌측: 날짜/목록 -->
       <item>
        <layout class="QVBoxLayout">
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>날짜:</string></property></widget></item>
           <item><widget class="QDateEdit" name="date_edit_encounter"/></item>
           <item><widget class="QPushButton" name="btn_load_encounters"><property name="text"><string>목록조회</string></property></widget></item>
          </layout>
         </item>
         <item>
          <widget class="QListWidget" name="list_encounters"/>
         </item>
         <item>
          <widget class="QPushButton" name="btn_load_encounter_detail">
           <property name="text"><string>조회</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <!-- 우측: plain_note / enhanced_result -->
       <item>
        <layout class="QVBoxLayout">
         <item>
          <widget class="QPlainTextEdit" name="txt_plain_note">
           <property name="readOnly"><bool>true</bool></property>
           <property name="placeholderText"><string>진료 기록이 여기에 표시됩니다</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPlainTextEdit" name="txt_enhanced_result">
           <property name="placeholderText"><string>AI Enhance 결과가 여기에 표시됩니다</string></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </item>
    <!-- AI Agent 영역 -->
    <item>
     <widget class="QGroupBox" name="group_ai">
      <property name="title"><string>AI Agent</string></property>
      <layout class="QHBoxLayout">
       <item><widget class="QLabel"><property name="text"><string>모델 선택:</string></property></widget></item>
       <item><widget class="QComboBox" name="combo_ai_agent"/></item>
       <item><widget class="QPushButton" name="btn_enhance"><property name="text"><string>Enhance</string></property></widget></item>
       <item><widget class="QPushButton" name="btn_save_to_sigma"><property name="text"><string>시그마차트에 저장</string></property></widget></item>
      </layout>
     </widget>
    </item>
    <!-- 프롬프트 관리 영역 -->
    <item>
     <widget class="QGroupBox" name="group_prompts">
      <property name="title"><string>프롬프트 관리</string></property>
      <layout class="QHBoxLayout">
       <!-- 좌측: 프롬프트 목록 + 버튼 -->
       <item>
        <layout class="QVBoxLayout">
         <item><widget class="QListWidget" name="list_prompts"/></item>
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QPushButton" name="btn_prompt_new"><property name="text"><string>신규</string></property></widget></item>
           <item><widget class="QPushButton" name="btn_prompt_edit"><property name="text"><string>수정</string></property></widget></item>
           <item><widget class="QPushButton" name="btn_prompt_delete"><property name="text"><string>삭제</string></property></widget></item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QPushButton" name="btn_prompt_move_up"><property name="text"><string>▲ 위</string></property></widget></item>
           <item><widget class="QPushButton" name="btn_prompt_move_down"><property name="text"><string>▼ 아래</string></property></widget></item>
          </layout>
         </item>
        </layout>
       </item>
       <!-- 우측: 프롬프트 편집 -->
       <item>
        <layout class="QVBoxLayout">
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>제목:</string></property></widget></item>
           <item><widget class="QLineEdit" name="edit_prompt_title"/></item>
          </layout>
         </item>
         <item><widget class="QLabel"><property name="text"><string>내용:</string></property></widget></item>
         <item><widget class="QPlainTextEdit" name="txt_prompt_content"/></item>
         <item>
          <layout class="QHBoxLayout">
           <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
           <item><widget class="QPushButton" name="btn_prompt_save"><property name="text"><string>저장</string></property></widget></item>
          </layout>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
